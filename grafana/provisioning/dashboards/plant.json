          },
          "format": "time_series",
          "rawSql": "SELECT m.ts AS \"time\", m.value AS \"value\", v.code AS \"metric\" FROM measurement m JOIN variable_catalog v ON v.id = m.variable_id WHERE $__timeFilter(m.ts) AND v.code IN ('Battery_Active_Power', 'PVPCS_Active_Power', 'GE_Active_Power', 'FC_Active_Power', 'Island_mode_MCCB_Active_Power') ORDER BY m.ts;",
          "refId": "A"
