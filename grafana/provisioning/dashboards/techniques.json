        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "text",
      "title": "A value and its age",
      "options": {
        "mode": "markdown",
        "content": "The outlet temperature as it was **last received**, and **how long ago** that was. The age turns red after 30 s: the value beside it may no longer be true.\n\nCompare *Plant — as delivered*: its table shows the last values with no age at all."
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 10
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Outlet temperature — last received",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "seda_lab_postgresql"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "seda_lab_postgresql"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT value AS \"°C\" FROM measurement WHERE variable_id = 10 ORDER BY ts DESC LIMIT 1"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
