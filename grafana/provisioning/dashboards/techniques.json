    {
      "id": 21,
      "type": "text",
      "title": "Data completeness",
      "options": {
        "mode": "markdown",
        "content": "Rows stored per minute as a percentage of the expected **120** (10 signals × 12 publishes). Both ends of the window are aligned to whole minutes, so no partial minute is counted.\n\nA minute with **no** data has no row at all: look for a gap, not for a zero."
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 46
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Data completeness per minute",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "seda_lab_postgresql"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "seda_lab_postgresql"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', ts) AS time, round(count(*) * 100.0 / 120, 1) AS \"completeness %\" FROM measurement WHERE ts >= date_trunc('minute', $__timeFrom()::timestamp) AND ts < date_trunc('minute', (now() AT TIME ZONE 'UTC')) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
