  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1 · Every window is an editorial decision",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "text",
      "title": "Three windows, one signal",
      "options": {
        "mode": "markdown",
        "content": "Generator-set active power as the **last sample**, the **mean over 1 minute** and the **mean over 15 minutes**.\n\nThe same machine, three stories: jumpy and honest, smooth and slightly late, calm and badly lagging. Which one answers *is the generator dropping now?* Which answers *how was the last hour?*"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Generator-set active power — three windows",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "seda_lab_postgresql"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "seda_lab_postgresql"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, value AS \"last sample\" FROM measurement WHERE variable_id = 3 AND $__timeFilter(ts) ORDER BY 1"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "seda_lab_postgresql"
          },
          "refId": "B",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, v AS \"mean 1 min\" FROM (SELECT ts AS time, avg(value) OVER (ORDER BY ts RANGE BETWEEN interval '1 minute' PRECEDING AND CURRENT ROW) AS v FROM measurement WHERE variable_id = 3 AND ts > $__timeFrom()::timestamp - interval '1 minute') s WHERE $__timeFilter(time) ORDER BY 1"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "seda_lab_postgresql"
          },
          "refId": "C",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, v AS \"mean 15 min\" FROM (SELECT ts AS time, avg(value) OVER (ORDER BY ts RANGE BETWEEN interval '15 minutes' PRECEDING AND CURRENT ROW) AS v FROM measurement WHERE variable_id = 3 AND ts > $__timeFrom()::timestamp - interval '15 minutes') s WHERE $__timeFilter(time) ORDER BY 1"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "2 · Every current value carries its age",
      "collapsed": false,
