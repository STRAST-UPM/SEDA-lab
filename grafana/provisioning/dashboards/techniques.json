    },
    {
      "id": 7,
      "type": "stat",
      "title": "…received this many seconds ago",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "seda_lab_postgresql"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "seda_lab_postgresql"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(extract(epoch FROM ((now() AT TIME ZONE 'UTC') - max(ts)))::numeric, 0) AS \"age\" FROM measurement WHERE variable_id = 10 AND ts <= (now() AT TIME ZONE 'UTC')"
        }
      ],
      "gridPos": {
        "h": 8,
