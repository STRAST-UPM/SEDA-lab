{
  "uid": "seda-platform",
  "title": "Platform",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Processor by service (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "seda_lab_prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "seda_lab_prometheus"
          },
          "refId": "A",
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory by service",
      "datasource": {
        "type": "prometheus",
        "uid": "seda_lab_prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "seda_lab_prometheus"
          },
          "refId": "A",
          "expr": "sum by (service) (container_memory_working_set_bytes)",
          "legendFormat": "{{service}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network received by service",
      "datasource": {
        "type": "prometheus",
        "uid": "seda_lab_prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "seda_lab_prometheus"
          },
          "refId": "A",
          "expr": "sum by (service) (rate(container_network_receive_bytes_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network sent by service",
      "datasource": {
        "type": "prometheus",
        "uid": "seda_lab_prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "seda_lab_prometheus"
          },
          "refId": "A",
          "expr": "sum by (service) (rate(container_network_transmit_bytes_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Scrape targets (up)",
      "datasource": {
        "type": "prometheus",
        "uid": "seda_lab_prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "seda_lab_prometheus"
          },
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    }
  ],
  "tags": [
    "seda-block5"
  ]
}
